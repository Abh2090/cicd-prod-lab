name: CI-CD Blue Green

on:
  push:
    branches:
      - main

jobs:
  build-and-deploy:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout Code
        uses: actions/checkout@v3

      - name: Docker Login
        uses: docker/login-action@v2
        with:
          username: ${{ secrets.DOCKER_USERNAME }}
          password: ${{ secrets.DOCKER_PASSWORD }}

      - name: Build Docker Image
        run: docker build -t ${{ secrets.DOCKER_USERNAME }}/cicd-app:latest .

      - name: Push Docker Image
        run: docker push ${{ secrets.DOCKER_USERNAME }}/cicd-app:latest

      - name: Deploy to EC2
        uses: appleboy/ssh-action@v1.0.0
        with:
          host: ${{ secrets.EC2_HOST }}
          username: ubuntu
          key: ${{ secrets.EC2_KEY }}
          script: |
            docker pull ${{ secrets.DOCKER_USERNAME }}/cicd-app:latest

            if grep -q "3001" /etc/nginx/nginx.conf; then
              echo "BLUE active → switching to GREEN"

              docker stop green || true
              docker rm green || true

              docker run -d -p 3002:3000 \
              -e MESSAGE="Hello from GREEN 💚" \
              --name green \
              ${{ secrets.DOCKER_USERNAME }}/cicd-app:latest

              sudo bash -c 'cat > /etc/nginx/nginx.conf <<EOF
worker_processes auto;
events { worker_connections 1024; }
http {
  server {
    listen 80;
    location / {
      proxy_pass http://127.0.0.1:3002;
    }
  }
}
EOF'

            else
              echo "GREEN active → switching to BLUE"

              docker stop blue || true
              docker rm blue || true

              docker run -d -p 3001:3000 \
              -e MESSAGE="Hello from BLUE 💙" \
              --name blue \
              ${{ secrets.DOCKER_USERNAME }}/cicd-app:latest

              sudo bash -c 'cat > /etc/nginx/nginx.conf <<EOF
worker_processes auto;
events { worker_connections 1024; }
http {
  server {
    listen 80;
    location / {
      proxy_pass http://127.0.0.1:3001;
    }
  }
}
EOF'

            fi

            sudo systemctl restart nginx
